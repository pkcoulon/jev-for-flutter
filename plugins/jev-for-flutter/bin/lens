_PIPES = []


class Tracer(jev.Client):
    def __init__(self, cfg):
        super().__init__(cfg, "lens")
        self.models, self.requests, self.tokens = set(), 0, 0
        self.budget = float(cfg["jev"]["cli_timeout_s"])
        self.per_request = self.timeout
        self.deadline = None

    def start(self):
        if self.deadline is None:
            self.deadline = time.monotonic() + self.budget

    def remaining(self):
        return self.budget if self.deadline is None else self.deadline - time.monotonic()

    def _reserve(self):
        if self.remaining() < 0.2:
            raise jev.JevError("délai global dépassé", -2)
        super()._reserve()

    def _post(self, body):
        remaining = self.remaining()
        if remaining < 0.2:
            raise jev.JevError("délai global dépassé", -2)
        self.timeout = min(self.per_request, remaining)
        with self._lock:
            self.requests += 1
            self.tokens += jev.estimate_tokens(body)
        try:
            result = super()._post(body)
        except jev.JevError as error:
            # The base client sleeps up to 3 s before a retry without looking at our deadline.
            if error.status in RETRYABLE and self.remaining() < RETRY_FLOOR_S:
                raise jev.JevError("délai global dépassé après %s" % error.kind, -2) from None
            raise
        if not isinstance(result, dict) or not isinstance(result.get("answers"), dict):
            raise jev.JevError("réponse invalide de Jev", -1)
        if not isinstance(result.get("usage"), dict):
            result["usage"] = {}
        if result.get("model"):
            with self._lock:
                self.models.add(str(result["model"]))
        return result


class Run:
    def __init__(self, mode, local=False):
        self.mode = mode
        self.started = time.monotonic()
        self.root = project.project_root()
        self.cfg = config.load(self.root)
        allowed, reason = policy.jev_allowed(self.root, self.cfg, "lens")
        if local and allowed:
            allowed, reason = False, "demandé (--local)"
        self.allowed, self.reason = allowed, reason
        self.client = Tracer(self.cfg) if allowed else None
        self.model = jev.model_name(self.cfg)
        self.errors = []
        self.failed = False
        self.record = {"mode": mode}

    def model_label(self):
        seen = sorted(self.client.models) if self.client else []
        return ", ".join(seen) if seen else self.model

    def seconds(self):
        return time.monotonic() - self.started

    def rel(self, path):
        resolved = Path(path).resolve()
        inside = resolved == self.root or self.root in resolved.parents
        return project.rel(resolved, self.root) if inside else str(path)

    def log(self, **fields):
        record = dict(self.record, ts=round(time.time(), 3), ms=int(self.seconds() * 1000), backend=fields.pop("backend", None))
        if self.client:
            record.update(requests=self.client.requests, tokens_est=self.client.tokens)
        record.update(fields)
        try:
            LOG.parent.mkdir(parents=True, exist_ok=True)
            with open(LOG, "a") as handle:
                handle.write(json.dumps(record) + "\n")
        except OSError:
            pass


def error_text(error):
    status = getattr(error, "status", 0)
    known = {401: "clé TypeSafe refusée (401)", 429: "limite de débit (429) malgré les reprises",
             529: "Jev surchargé (529) malgré les reprises", -1: "réponse invalide de Jev",
             -2: "délai global de Jev dépassé (jev.cli_timeout_s)"}
    if status == -2 and " après " in str(error):
        return "%s, dernière erreur : %s" % (known[-2], str(error).split(" après ", 1)[1])
    if status in known:
        return known[status]
    if status == 422:
        return "requête refusée (422) : %s" % str(error)[10:120]
    if status == 0:
        return "réseau, délai ou réponse illisible : %s" % str(error).replace("réseau: ", "")[:120]
    return str(error)[:160]


def noul_p(answer):
    if not isinstance(answer, dict):
        return None
    value = jev.probability(answer)
    if isinstance(value, bool) or not isinstance(value, (int, float)) or not 0 <= value <= 1:
        return None
    return float(value)


def choice_of(answer, options):
    if not isinstance(answer, dict):
        return None
    picked = answer.get("choice")
    return picked if picked in options else None


def fit(text, limit):
    if jev.estimate_tokens(text) <= limit:
        return text, False
    return text[:max(200, int(limit * jev.CHARS_PER_TOKEN) - 40)] + "\n[… tronqué pour Jev]", True


def pack(base, field, items, question_for, tag, reserve=0):
    budget = jev.STATE_TOKEN_BUDGET - reserve
    base_tokens = jev.estimate_tokens(base) + 8
    chunks_, current, used, longest = [], {}, base_tokens, 0
    for key, value in items:
        size = jev.estimate_tokens({key: value})
        need = jev.estimate_tokens(question_for(key)) if question_for else 0
        if current and (used + size + max(longest, need) > budget or len(current) >= MAX_QUESTIONS):
            chunks_.append(current)
            current, used, longest = {}, base_tokens, 0
        current[key] = value
        used += size
        longest = max(longest, need)
    if current:
        chunks_.append(current)
    if not question_for:
        return chunks_
    return [(dict(base, **{field: chunk}), {k: question_for(k) for k in chunk}, field, tag) for chunk in chunks_]


def ask_all(client, requests, depth=0):
    client.start()
    answers, errors, again = {}, [], []
    results = client.ask_many([(state, questions) for state, questions, _, _ in requests]) if requests else []
    for (state, questions, field, tag), result in zip(requests, results):
        if isinstance(result, jev.JevError):
            items = state.get(field) if field else None
            if result.status == 422 and items and len(items) > 1 and depth < 3:
                keys = list(items)
                for part in (keys[:len(keys) // 2], keys[len(keys) // 2:]):
                    again.append((dict(state, **{field: {k: items[k] for k in part}}),
                                  {k: questions[k] for k in part if k in questions}, field, tag))
                continue
            errors.append(error_text(result))
            for key in questions:
                answers[(tag, key)] = None
        else:
            for key in questions:
                answers[(tag, key)] = result.get(key)
    if again:
        more, more_errors = ask_all(client, again, depth + 1)
        answers.update(more)
        errors += more_errors
    return answers, errors


def block_question(key, noun):
    return jev.noul(
        {"question": "Does `blocks.%s` contain %s needed to answer `question`?" % (key, noun),
         "focus": "Judge only `blocks.%s`; the other blocks are context. Yes if someone answering the question must read it." % key},
        "Needed to answer the question", "Not needed to answer the question")


def span(block):
    if block.get("cols"):
        return "%d:%d-%d" % (block["start"], block["cols"][0], block["cols"][1])
    return "%d-%d" % (block["start"], block["end"])


def block_items(blocks, base, field_name, source=None):
    limit = jev.STATE_TOKEN_BUDGET - jev.estimate_tokens(base) - 400
    items = []
    redacted = chunks.split_lines(policy.redact(source)) if source is not None else None
    for block in blocks:
        text = policy.redact(block["text"])
        if redacted is not None:
            text = "\n".join(redacted[block["start"] - 1:block["end"]])
            if block.get("cols"):
                text = text[block["cols"][0] - 1:block["cols"][1]]
        label = policy.redact(block["label"]) if text == block["text"] else "passage partiellement masqué"
        text, cut = fit(text, limit)
        block["truncated"] = cut
        lines = "%d-%d" % (block["start"], block["end"]) if not block.get("cols") else "%d (chars %d-%d)" % (
            block["start"], block["cols"][0], block["cols"][1])
        items.append((block["id"], {"lines": lines, "label": label, field_name: text}))
    return items


def local_scores(question, blocks):
    if not blocks:
        return {}
    scores = bm25.BM25([b["label"] + "\n" + b["text"] for b in blocks]).scores(question)
    return {b["id"]: s for b, s in zip(blocks, scores)}


def local_selection(blocks, scores, total_chars):
    top = max(scores.values(), default=0)
    if top <= 0:
        return set()
    chosen, used = set(), 0
    for block in sorted(blocks, key=lambda b: scores[b["id"]], reverse=True):
        size = len(block["text"]) + 1
        if scores[block["id"]] < 0.35 * top or (chosen and used + size > 0.4 * total_chars):
            break
        chosen.add(block["id"])
        used += size
    return chosen


def ranges(numbers):
    out = []
    for n in sorted(numbers):
        if out and n == out[-1][1] + 1:
            out[-1][1] = n
        else:
            out.append([n, n])
    return out


def gaps(spans, length):
    out, cursor = [], 1
    for a, b in sorted(spans):
        if a > cursor:
            out.append((cursor, a - 1))
        cursor = max(cursor, b + 1)
    if cursor <= length:
        out.append((cursor, length))
    return out


def base_label(label):
    return re.sub(r" \[\d+/\d+\]$", "", label)


def numbered(lines, a, b):
    return "".join("%6d\t%s\n" % (n, lines[n - 1]) for n in range(a, b + 1))


def score_text(item):
    if item["context_of"]:
        return "(contexte)"
    if item["kind"] == "always":
        return "(toujours conservé)"
    value = item["score"]
    if value is None:
        return "p=? (non jugé, affiché par défaut)"
    return ("bm25=%.1f" if item["local"] else "p=%.2f") % value


def read_hint(source, command=False):
    tail = " ou lens --all -- …" if command else " ou lens --all"

    def hint(block):
        if block.get("cols"):
            return "sed -n '%dp' %s | cut -c %d-%d%s" % (block["start"], source, block["cols"][0], block["cols"][1], tail)
        return "sed -n '%d,%dp' %s%s" % (block["start"], block["end"], source, tail)
    return hint


def giant_note(blocks):
    cut = {b["start"] for b in blocks if b.get("cols")}
    if not cut:
        return []
    return ["-- lignes géantes découpées (%d lignes) : @@ N:a-b = ligne N, caractères a à b" % len(cut)]


def cap_display(blocks, shown, scores):
    used = sum(len(b["text"]) + 8 * (b["end"] - b["start"] + 1) for b in blocks if b["kind"] == "always")
    ranked = sorted((b for b in blocks if b["id"] in shown and b["kind"] != "always"),
                    key=lambda b: (-(scores.get(b["id"]) if scores.get(b["id"]) is not None else 1.0), b["start"]))
    kept = set()
    for block in ranked:
        size = len(block["text"]) + 8 * (block["end"] - block["start"] + 1)
        if kept and used + size > DISPLAY_MAX_CHARS:
            continue
        kept.add(block["id"])
        used += size
    return kept, len(ranked) - len(kept)


def render_selection(target, lines, blocks, scores, shown, local, backend, hint, extra=(), meta=None):
    total = len(lines)
    meta = meta or "%d lignes" % total
    by_id = {b["id"]: b for b in blocks}
    askable = [b for b in blocks if not b["context"]]
    pieces = any(b.get("cols") for b in blocks)
    shown, overflow = cap_display(blocks, shown, scores)
    if overflow:
        extra = list(extra) + ["-- %d blocs retenus non affichés : plafond d'affichage de %d caractères atteint (les mieux notés d'abord) ; "
                               "ils figurent dans « omis »" % (overflow, DISPLAY_MAX_CHARS)]
    context_of = {}
    for bid in list(shown):
        parent = by_id.get(by_id[bid].get("parent"))
        if parent and parent["id"] not in shown and parent["end"] - parent["start"] + 1 <= PARENT_CONTEXT_LINES \
                and not parent.get("cols"):
            context_of[parent["id"]] = bid
    display = sorted(set(shown) | set(context_of) | {b["id"] for b in blocks if b["kind"] == "always"},
                     key=lambda i: (by_id[i]["start"], (by_id[i].get("cols") or (0,))[0], by_id[i]["end"]))
    covered = set()
    for bid in display:
        if not by_id[bid].get("cols"):
            covered.update(range(by_id[bid]["start"], by_id[bid]["end"] + 1))
    selected = [b for b in askable if b["id"] in shown]
    out = []

    def head(count):
        return "== {} ({}) · {}/{} blocs · {}/{} lignes · {}".format(target, meta, len(selected), len(askable), count, total, backend)

    if not selected and not any(b["kind"] == "always" for b in blocks):
        judged = [(scores.get(b["id"]), b) for b in askable if scores.get(b["id"]) is not None]
        best = max(judged, key=lambda item: item[0], default=(None, None))
        out.append(head(0))
        out.extend(extra)
        if best[1] is not None and best[0] > 0:
            out.append("-- aucun bloc retenu (%s max = %.2f : @@ %s %s)" % (
                "bm25" if local else "p", best[0], span(best[1]), best[1]["label"]))
        else:
            out.append("-- aucun bloc retenu (aucun terme de la question trouvé)" if local else "-- aucun bloc retenu")
        out.append("-- carte des blocs :")
        listing = blocks if len(blocks) <= MAP_LIMIT else sorted(
            sorted(askable, key=lambda b: scores.get(b["id"]) or 0, reverse=True)[:MAP_LIMIT],
            key=lambda b: (b["start"], (b.get("cols") or (0,))[0]))
        for b in listing:
            value = scores.get(b["id"])
            tag = "(contexte)" if b["context"] else ("bm25=%.1f" % value if local else "p=%.2f" % value) if value is not None else "p=?"
            out.append("   %s %s %s" % (span(b), b["label"], tag))
        if len(listing) < len(blocks):
            out.append("   … %d autres blocs moins probables" % (len(blocks) - len(listing)))
        example = best[1] or (askable or blocks)[0]
        out.append("-- la réponse n'est peut-être pas ici, ou la question est trop vague : reformule, lis une plage (%s) ou relance avec --all." %
                   hint(example))
        return "\n".join(out) + "\n", 0, selected, True
    total_chars = sum(len(line) + 1 for line in lines)
    if not pieces and len(covered) >= SHOW_ALL_RATIO * total and total_chars <= DISPLAY_MAX_CHARS:
        out.append(head(total) + " · sélection ≥ 60 % des lignes → intégral")
        out.extend(extra)
        out.append(numbered(lines, 1, total).rstrip("\n"))
        return "\n".join(out) + "\n", total, selected, False
    body, printed, partial = [], set(), {}
    for bid in display:
        block = by_id[bid]
        item = {"context_of": bid in context_of, "kind": block["kind"], "score": scores.get(bid), "local": local}
        cols = block.get("cols")
        if cols:
            n, line = block["start"], lines[block["start"] - 1]
            partial.setdefault(n, []).append(tuple(cols))
            body.append("@@ %s %s %s" % (span(block), block["label"], score_text(item)))
            body.append("%6d\t%s%s%s" % (n, "…" if cols[0] > 1 else "", line[cols[0] - 1:cols[1]], "…" if cols[1] < len(line) else ""))
            continue
        fresh = [n for n in range(block["start"], block["end"] + 1) if n not in printed]
        if not fresh:
            continue
        body.append("@@ %d-%d %s %s" % (fresh[0], fresh[-1], block["label"], score_text(item)))
        body.append(numbered(lines, fresh[0], fresh[-1]).rstrip("\n"))
        printed.update(fresh)
    shown_count = len(printed | set(partial))
    out.append(head(shown_count))
    out.extend(extra)
    out.extend(body)
    omitted = ranges(set(range(1, total + 1)) - printed - set(partial))
    cuts = [(n, gaps(spans, len(lines[n - 1]))) for n, spans in sorted(partial.items())]
    cuts = [(n, missing) for n, missing in cuts if missing]
    if omitted or cuts:
        out.append("-- omis (%d lignes%s) :" % (total - shown_count, ", %d en partie" % len(cuts) if cuts else ""))
        for a, b in omitted:
            labels = []
            for block in blocks:
                if block["start"] <= b and block["end"] >= a and block["id"] not in display:
                    label = base_label(block["label"]) + (" (contexte)" if block["context"] else "")
                    if label not in labels:
                        labels.append(label)
            more = " +%d" % (len(labels) - 3) if len(labels) > 3 else ""
            out.append("   %d-%d %s%s" % (a, b, " · ".join(labels[:3]), more))
        for n, missing in cuts:
            listed = ", ".join("%d-%d" % m for m in missing[:6]) + (" +%d" % (len(missing) - 6) if len(missing) > 6 else "")
            out.append("   %d (car. %s)" % (n, listed))
        hidden = [b for b in askable if b["id"] not in display] or blocks
        example = max(hidden, key=lambda b: scores.get(b["id"]) or 0)
        out.append("-- lire un bloc omis : %s" % hint(example))
    return "\n".join(out) + "\n", shown_count, selected, False


def load_text(path):
    data = Path(path).read_bytes()
    if b"\0" in data[:8192]:
        raise ValueError("fichier binaire")
    return data.decode("utf-8", "replace"), hashlib.sha1(data).hexdigest()


def blocks_for(path, text, structure):
    if Path(path).suffix == ".dart" and structure:
        return chunks.dart_blocks(str(path), text, structure, secrets=SECRETS)
    return chunks.text_blocks(text, secrets=SECRETS)


def structures_for(run, files, texts=None):
    dart = [str(f) for f in files if Path(f).suffix == ".dart"]
    if not dart:
        return {}, {}, ""
    data, approx, note = outline.outline(dart, run.root,
                                         build=not os.environ.get("JEV_FLUTTER_OUTLINE_NO_BUILD") and "background")
    approx_files = {path: note for path in dart} if approx else {}
    for path in dart:
        entry = data.get(path)
        if entry and not entry.get("error"):
            continue
        try:
            text = texts[path] if texts and path in texts else load_text(path)[0]
            data[path] = outline.regex_outline(text)
            approx_files[path] = "outline en erreur : %s" % chunks.clip((entry or {}).get("error") or "absent", 100)
        except (OSError, ValueError) as error:
            data[path] = {"error": str(error)}
    return data, approx_files, note


def parse_focus(argv):
    command = None
    if "--" in argv:
        index = argv.index("--")
        argv, command = argv[:index], argv[index + 1:]
    parser = argparse.ArgumentParser(prog="lens", usage=USAGE, add_help=False)
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("--threshold", type=float)
    parser.add_argument("--all", action="store_true")
    parser.add_argument("--local", action="store_true")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--timeout", type=float, default=900)
    parser.add_argument("question", nargs="?")
    parser.add_argument("paths", nargs="*")
    args = parser.parse_args(argv)
    args.command = command
    return args


def focus_files(args):
    run = Run("focus", args.local)
    threshold = args.threshold if args.threshold is not None else run.cfg["lens"]["threshold"]
    notes, results = [], []
    targets = args.paths
    limit = int(run.cfg["lens"].get("max_files") or 20)
    if len(targets) > limit:
        notes.append("-- %d fichiers au-delà de lens.max_files=%d ignorés : %s" % (len(targets) - limit, limit, " ".join(targets[limit:])))
        targets = targets[:limit]
    files = []
    for raw in targets:
        info = {"arg": raw, "path": Path(raw)}
        if not info["path"].exists():
            info["error"] = "introuvable"
        elif info["path"].is_dir():
            info["error"] = "dossier : utilise lens find ou lens which"
        else:
            try:
                info["text"], info["digest"] = load_text(info["path"])
                info["lines"] = chunks.split_lines(info["text"])
                info["large"] = not args.all and (len(info["lines"]) > FULL_FILE_LINES or len(info["text"]) > FULL_CHARS)
            except (OSError, ValueError) as error:
                info["error"] = str(error)
        files.append(info)
    large = [f for f in files if f.get("large")]
    structures, approx_files, _ = structures_for(run, [f["path"] for f in large], {str(f["path"]): f["text"] for f in large})
    if large and not run.allowed:
        notes.insert(0, "(mode local : %s)" % run.reason)
    requests = []
    for index, info in enumerate(files):
        if not info.get("large"):
            continue
        info["blocks"] = blocks_for(info["path"], info["text"], structures.get(str(info["path"])))
        info["approx"] = approx_files.get(str(info["path"])) if info["path"].suffix == ".dart" else None
        info["sendable"] = policy.sendable(info["path"], run.root)
        info["askable"] = [b for b in info["blocks"] if not b["context"]]
        if run.allowed and info["sendable"] and info["askable"]:
            base = {"question": policy.redact(args.question), "file": run.rel(info["path"])}
            header = next((b for b in info["blocks"] if b["kind"] == "directives"), None)
            if header:
                base["imports"] = fit(policy.redact(header["text"]), 600)[0]
            items = block_items(info["askable"], base, "code", info["text"])
            requests += pack(base, "blocks", items, lambda key: block_question(key, "code or text"), index)
    answers, errors = ask_all(run.client, requests) if requests else ({}, [])
    run.errors += errors
    if requests and all(v is None for v in answers.values()):
        notes.append("(mode local : Jev en erreur — %s)" % ("; ".join(sorted(set(errors))) or "aucune réponse exploitable"))
        run.failed = True
    stats = {"files": len(files), "blocks": 0, "selected": 0, "shown": 0, "total": 0, "p_max": None}
    for index, info in enumerate(files):
        results.append(render_file(run, args, info, index, answers, errors, threshold, stats))
    run.log(backend="jev" if requests and not all(v is None for v in answers.values()) else "local" if large else "full",
            files=stats["files"], blocks=stats["blocks"], selected=stats["selected"], p_max=stats["p_max"],
            shown_lines=stats["shown"], total_lines=stats["total"], errors=len(errors))
    if args.json:
        print(json.dumps({"notes": notes, "files": results}, ensure_ascii=False, indent=1))
    else:
        sys.stdout.write("".join(n + "\n" for n in notes) + "".join(r["text"] for r in results))
    return 1 if any(f.get("error") for f in files) else 0


def render_file(run, args, info, index, answers, errors, threshold, stats):
    target = info["arg"]
    result = {"path": target}
    if info.get("error"):
        result.update(error=info["error"], text="== %s : %s\n" % (target, info["error"]))
        return result
    lines, total = info["lines"], len(info["lines"])
    stats["total"] += total
    if "blocks" not in info:
        reason = "--all" if args.all else "fichier court, sans Jev"
        stats["shown"] += total
        result.update(lines=total, mode="full", text="== %s (%d lignes) · intégral (%s)\n%s" % (target, total, reason, numbered(lines, 1, total)))
        return result
    blocks, askable = info["blocks"], info["askable"]
    extra = []
    if info["approx"] is not None:
        extra.append("-- outline approx pour ce fichier (repli regex%s)" % (" : " + info["approx"] if info["approx"] else ""))
    extra += giant_note(blocks)
    scores = {b["id"]: noul_p(answers.get((index, b["id"]))) for b in askable} if run.allowed and info["sendable"] else {}
    judged = [v for v in scores.values() if v is not None]
    local = not judged
    if local:
        if run.allowed and not info["sendable"]:
            extra.append("(mode local pour ce fichier : hors du projet ou refusé par la politique, rien n'est envoyé à Jev)")
        elif run.allowed and not run.failed and askable:
            extra.append("(mode local pour ce fichier : Jev en erreur — %s)" % ("; ".join(sorted(set(errors))) or "aucune réponse exploitable"))
        scores = local_scores(args.question, askable)
        shown = local_selection(askable, scores, len(info["text"]))
        backend = "BM25 local (lexical)"
    else:
        shown = {bid for bid, v in scores.items() if v is None or v >= threshold}
        missing = sum(1 for v in scores.values() if v is None)
        if missing:
            extra.append("-- %d blocs non jugés (%s) : affichés par défaut" % (missing, "; ".join(sorted(set(errors))) or "réponse incomplète"))
        truncated = sum(1 for b in askable if b.get("truncated"))
        if truncated:
            extra.append("-- %d blocs tronqués pour tenir dans le budget de Jev" % truncated)
        backend = "Jev %s" % run.model_label()
        stats["p_max"] = max(judged + ([stats["p_max"]] if stats["p_max"] is not None else []))
    try:
        changed = load_text(info["path"])[1] != info["digest"]
    except (OSError, ValueError):
        changed = True
    if changed:
        extra.append("!! fichier modifié depuis sa lecture : affichage de la version jugée, les numéros peuvent être décalés ; relis le fichier ou relance lens")
    text, shown_lines, selected, empty = render_selection(target, lines, blocks, scores, shown, local, backend,
                                                          read_hint(shlex.quote(target)), extra)
    stats["blocks"] += len(askable)
    stats["selected"] += len(selected)
    stats["shown"] += shown_lines
    result.update(lines=total, mode="local" if local else "jev", changed=changed, text=text, shown_lines=shown_lines,
                  blocks=[{"id": b["id"], "start": b["start"], "end": b["end"], "cols": b.get("cols"), "label": b["label"],
                           "kind": b["kind"], "score": scores.get(b["id"]), "selected": b["id"] in shown} for b in blocks])
    return result


def prune_raw():
    cutoff = time.time() - RAW_TTL_S
    for path in RAW_DIR.glob("**/*.txt"):
        try:
            if path.stat().st_mtime < cutoff:
                path.unlink()
        except FileNotFoundError:
            continue
    for directory in RAW_DIR.iterdir():
        try:
            if directory.is_dir() and directory.stat().st_mtime < cutoff:
                directory.rmdir()
        except OSError:
            pass


def save_raw(data):
    session = re.sub(r"[^A-Za-z0-9_-]", "", os.environ.get("CLAUDE_CODE_SESSION_ID", ""))[:64] or "sans-session"
    try:
        RAW_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        prune_raw()
        directory = RAW_DIR / session
        directory.mkdir(exist_ok=True, mode=0o700)
        stem = "%s-%d" % (time.strftime("%Y%m%d-%H%M%S"), os.getpid())
        for attempt in range(100):
            path = directory / ("%s%s.txt" % (stem, "-%d" % attempt if attempt else ""))
            try:
                fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                break
            except FileExistsError:
                continue
        else:
            return None
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
        return str(path)
    except OSError:
        return None


def kill_group(pgid, signum):
    try:
        os.killpg(pgid, signum)
    except OSError:
        pass


def group_alive(pgid):
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def run_command(argv, timeout):
    process = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                               start_new_session=True)
    # Keep the pipe object alive: closing its fd while the reader thread is blocked could let the number be reused.
    _PIPES.append(process)
    fd, parts, done = process.stdout.fileno(), [], threading.Event()

    def pump():
        try:
            while True:
                data = os.read(fd, 65536)
                if not data:
                    break
                parts.append(data)
        except OSError:
            pass
        done.set()

    threading.Thread(target=pump, daemon=True).start()
    deadline = time.monotonic() + timeout
    timed_out = detached = False
    try:
        try:
            process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            timed_out = True
        while not timed_out and not done.wait(0.1):
            if not group_alive(process.pid):
                detached = not done.wait(DRAIN_S)
                break
            if time.monotonic() >= deadline:
                timed_out = True
        if timed_out:
            kill_group(process.pid, signal.SIGKILL)
            try:
                process.wait(timeout=DRAIN_S)
            except subprocess.TimeoutExpired:
                pass
            detached = not done.wait(DRAIN_S)
    except KeyboardInterrupt:
        kill_group(process.pid, signal.SIGTERM)
        raise
    return b"".join(parts), process.returncode, timed_out, detached


def exit_status(returncode, timed_out, timeout):
    if timed_out:
        return 124, "exit 124 : interrompue après %g s" % timeout
    if returncode is not None and returncode < 0:
        try:
            name = signal.Signals(-returncode).name
        except ValueError:
            name = "signal %d" % -returncode
        return 128 - returncode, "exit %d (%s)" % (128 - returncode, name)
    return returncode or 0, "exit %d" % (returncode or 0)


def script_words(script):
    lexer = shlex.shlex(script, posix=True, punctuation_chars=True)
    lexer.whitespace_split = True
    words, position = [], "command"
    try:
        for token in lexer:
            if token and set(token) <= set("();<>|&"):
                position = "skip" if ">" in token and "<" not in token else "arg" if "<" in token else "command"
                continue
            if position != "skip":
                words.append((token, position == "command"))
            position = "arg"
    except ValueError:
        return None
    return words


def command_words(argv):
    words, script_at = [(argv[0], True)], None
    if os.path.basename(argv[0]) in SHELLS:
        script_at = next((i + 1 for i, arg in enumerate(argv[1:], 1) if re.match(r"^-[A-Za-z]*c[A-Za-z]*$", arg)), None)
    for index, arg in enumerate(argv[1:], 1):
        if index == script_at:
            parsed = script_words(arg)
            if parsed is None:
                return None
            words += parsed
        else:
            words.append((arg, False))
    return words


def existing_paths(token):
    token = os.path.expanduser(os.path.expandvars(token))
    if not token:
        return []
    if any(c in token for c in "*?["):
        try:
            return glob.glob(token)[:200]
        except (OSError, ValueError, re.error):
            return []
    return [token] if os.path.lexists(token) else []


def is_program(path, command):
    return os.path.isfile(path) and os.access(path, os.X_OK) and (command or Path(path).parent.name in ("bin", "sbin"))


def command_refusal(argv, root):
    cwd = os.getcwd()
    if not policy.sendable(cwd, root):
        return "dossier courant %s hors du projet ou refusé" % cwd
    words = command_words(argv)
    if words is None:
        return "script shell illisible (guillemets non fermés)"
    for token, command in words:
        for candidate in [token] + ([token.split("=", 1)[1]] if "=" in token else []):
            for path in existing_paths(candidate):
                if path in SAFE_PATHS or is_program(path, command):
                    continue
                if not policy.sendable(Path(path), root):
                    return "la commande lit %s, hors du projet ou refusé" % path
    return None


def focus_command(args):
    run = Run("command", args.local)
    threshold = args.threshold if args.threshold is not None else run.cfg["lens"]["threshold"]
    argv = args.command
    started = time.monotonic()
    try:
        raw, returncode, timed_out, detached = run_command(argv, args.timeout)
    except FileNotFoundError:
        sys.stderr.write("lens : commande introuvable : %s\n" % argv[0])
        return 127
    except PermissionError:
        sys.stderr.write("lens : commande non exécutable : %s\n" % argv[0])
        return 126
    code, status = exit_status(returncode, timed_out, args.timeout)
    status += ", %.1f s" % (time.monotonic() - started)
    text = raw.decode("utf-8", "replace")
    lines = chunks.split_lines(text)
    total = len(lines)
    title = "$ " + chunks.clip(shlex.join(argv), 100)
    warn = "-- sortie tronquée : un processus détaché garde la sortie ouverte (lecture arrêtée %g s après la fin de la commande)\n" % DRAIN_S \
        if detached else ""
    if args.all or (total <= FULL_OUTPUT_LINES and len(text) <= FULL_CHARS):
        sys.stdout.write("== %s (%d lignes, %s) · intégral\n%s%s%s" % (
            title, total, status, warn, text, "" if text.endswith("\n") or not text else "\n"))
        run.log(backend="full", total_lines=total, shown_lines=total, exit=code)
        return code
    raw_path = save_raw(raw)
    blocks, kept_info = chunks.output_blocks(text, secrets=SECRETS)
    askable = [b for b in blocks if not b["context"]]
    extra, scores, errors, first = [], {}, [], ""
    allowed, reason = run.allowed, run.reason
    if allowed and askable:
        refused = command_refusal(argv, run.root)
        if refused:
            allowed, reason = False, refused
    if allowed and askable:
        shown_command = shlex.join(argv).replace(str(run.root) + "/", "").replace(str(Path.home()), "~")
        base = {"question": policy.redact(args.question), "command": policy.redact(shown_command)}
        requests = pack(base, "blocks", block_items(askable, base, "text", text), lambda key: block_question(key, "output lines"), 0)
        answers, errors = ask_all(run.client, requests)
        scores = {b["id"]: noul_p(answers.get((0, b["id"]))) for b in askable}
    judged = [v for v in scores.values() if v is not None]
    local = not judged
    if not askable:
        shown, backend = set(), "rien à juger"
    elif local:
        if allowed:
            first = "(mode local : Jev en erreur — %s)\n" % ("; ".join(sorted(set(errors))) or "aucune réponse exploitable")
        else:
            first = "(mode local : %s)\n" % reason
        scores = local_scores(args.question, askable)
        shown = local_selection(askable, scores, len(text))
        backend = "BM25 local (lexical)"
    else:
        shown = {bid for bid, v in scores.items() if v is None or v >= threshold}
        missing = sum(1 for v in scores.values() if v is None)
        if missing:
            extra.append("-- %d blocs non jugés (%s) : affichés par défaut" % (missing, "; ".join(sorted(set(errors))) or "réponse incomplète"))
        backend = "Jev %s" % run.model_label()
    kept = set()
    for b in blocks:
        if b["kind"] == "always":
            kept.update(range(b["start"], b["end"] + 1))
    note = "-- conservé d'office : 5 premières lignes, 30 dernières, lignes d'erreur ±2 (%d lignes)" % len(kept)
    dropped = kept_info["error_lines"] - kept_info["error_kept"]
    if dropped:
        note += " ; %d lignes d'erreur répétitives ou en surnombre jugées comme le reste" % dropped
    extra.append(note)
    extra += giant_note(blocks)
    if warn:
        extra.append(warn.rstrip("\n"))
    hint = read_hint(raw_path or "(sortie non enregistrée)", command=True)
    body, shown_lines, selected, _ = render_selection(title, lines, blocks, scores, shown, local, backend, hint, extra,
                                                      meta="%d lignes, %s" % (total, status))
    sys.stdout.write(first + body)
    if raw_path:
        print("-- sortie brute complète : %s" % raw_path)
    run.log(backend="none" if not askable else "local" if local else "jev", blocks=len(askable), selected=len(selected),
            p_max=max(judged) if judged else None, shown_lines=shown_lines, total_lines=total, exit=code, errors=len(errors))
    return code


def is_test_path(rel):
    parts = Path(rel).parts
    return any(p in TEST_DIRS for p in parts[:-1]) or rel.endswith("_test.dart")


def has_files(directory, extensions):
    for current, dirs, names in os.walk(directory):
        dirs[:] = [d for d in dirs if d not in ALWAYS_SKIP and not d.startswith(".")]
        if any(n.endswith(e) for n in names for e in extensions):
            return True
    return False


def collect(run, targets, extensions, include_tests, project_only=False):
    extensions = (".dart",) if project_only else extensions
    patterns = paths.generated_patterns(run.cfg, run.root)
    found, seen = [], set()
    stats = {"generated": 0, "tests": 0, "refused": 0, "missing": 0, "skipped_dirs": []}
    for target in targets:
        target = Path(target)
        if not target.exists():
            stats["missing"] += 1
            continue
        if target.is_file():
            candidates = [target] if not project_only or any(target.name.endswith(e) for e in extensions) else []
        else:
            candidates = []
            for current, dirs, names in os.walk(target):
                package = "pubspec.yaml" in names
                kept = []
                for name in sorted(dirs):
                    if name in ALWAYS_SKIP or name.startswith("."):
                        continue
                    if package and name in PLATFORM_DIRS:
                        if has_files(Path(current) / name, extensions):
                            stats["skipped_dirs"].append(run.rel(Path(current) / name))
                        continue
                    kept.append(name)
                dirs[:] = kept
                candidates += [Path(current) / n for n in sorted(names) if any(n.endswith(e) for e in extensions)]
        for path in candidates:
            resolved = path.resolve()
            if resolved in seen:
                continue
            seen.add(resolved)
            rel = run.rel(path)
            if paths.matches(rel, patterns):
                stats["generated"] += 1
                continue
            if not include_tests and is_test_path(rel):
                stats["tests"] += 1
                continue
            if (run.allowed or project_only) and not policy.sendable(path, run.root) \
                    or project_only and (policy.refusal(resolved.parent) or not resolved.name.endswith(".dart")
                                         or any(p.startswith(".") for p in Path(os.path.relpath(resolved, run.root)).parts)):
                stats["refused"] += 1
                continue
            found.append(path)
    return found, stats


def skeleton(rel, entry, text, secrets=None):
    def clean(value):
        return secrets.sub("[REDACTED]", value) if secrets else value
    if not entry or entry.get("error"):
        body = [l.strip() for l in chunks.split_lines(text) if l.strip()][:40]
        return chunks.clip(clean("%s\n%s" % (rel, "\n".join(body))), SKELETON_CHARS)
    out = ["%s (%d lines)" % (rel, entry.get("lines", 0))]
    for decl in entry.get("decls") or []:
        out.append(decl.get("signature", "") + (" — " + decl["doc"] if decl.get("doc") else ""))
        for child in (decl.get("children") or [])[:25]:
            out.append("  " + child.get("signature", ""))
    stack = [(t, 1) for t in entry.get("tests") or []]
    while stack and len(out) < 80:
        node, depth = stack.pop(0)
        out.append("  " * depth + "%s %s" % (node["kind"], node.get("name", "")))
        if depth < 2:
            stack = [(c, depth + 1) for c in node.get("children") or []] + stack
    text = clean("\n".join(out))
    return text if len(text) <= SKELETON_CHARS else text[:SKELETON_CHARS - 1] + "…"


def footer(run, stats, count, verb="criblés"):
    excluded = ", ".join("%d %s" % (stats[k], label) for k, label in (
        ("generated", "générés exclus"), ("tests", "tests exclus (--tests)"), ("refused", "refusés par la politique"),
        ("missing", "chemins introuvables")) if stats.get(k))
    parts = ["%d fichiers %s%s" % (count, verb, " (%s)" % excluded if excluded else "")]
    if run.client:
        parts += ["%d requêtes" % run.client.requests, "~%dk tokens estimés" % round(run.client.tokens / 1000)]
    parts.append("%.1f s" % run.seconds())
    parts.append("Jev %s" % run.model_label() if run.client and not run.failed else "BM25 local")
    lines = ["-- " + " · ".join(parts)]
    skipped = stats.get("skipped_dirs") or []
    if skipped:
        lines.append("-- %d dossier%s de plateforme ignoré%s : %s ; passe-le en argument pour l'inclure" % (
            len(skipped), "s" if len(skipped) > 1 else "", "s" if len(skipped) > 1 else "",
            ", ".join(skipped[:5]) + (" +%d" % (len(skipped) - 5) if len(skipped) > 5 else "")))
    return "\n".join(lines)


def locate(answer, sent, by_id, question):
    if len(sent) == 1:
        return by_id[sent[0]], True
    picked = choice_of(answer, sent)
    if picked:
        return by_id[picked], True
    blocks = [by_id[bid] for bid in sent]
    scores = local_scores(question, blocks)
    best = max(blocks, key=lambda b: scores[b["id"]])
    return (best, False) if scores[best["id"]] > 0 else (None, False)


def where_text(rel, block, exact):
    if block is None:
        return "%s  (bloc non localisé)" % rel
    if exact:
        return "%s:%d  %s" % (rel, block["line"], block["label"])
    return "%s:~%d  %s (emplacement estimé : Jev n'a pas désigné de bloc)" % (rel, block["line"], block["label"])


def find_main(argv):
    parser = argparse.ArgumentParser(prog="lens find", description="Localiser du code par description.")
    parser.add_argument("description")
    parser.add_argument("dirs", nargs="*")
    parser.add_argument("--top", type=int)
    parser.add_argument("--max-files", type=int, default=FIND_JEV_FILES,
                        help="plafond explicite du criblage Jev ; aucun fichier présélectionné par mots-clés")
    parser.add_argument("--tests", action="store_true")
    parser.add_argument("--local", action="store_true")
    parser.add_argument("--project-only", action="store_true", help="rester dans les chemins autorisés du projet, même en local")
    parser.add_argument("--min", type=float)
    args = parser.parse_args(argv)
    if args.max_files < 1 or args.max_files > MAX_FIND_FILES:
        parser.error("--max-files doit être compris entre 1 et %d" % MAX_FIND_FILES)
    run = Run("find", args.local)
    settings = run.cfg["find"]
    top = args.top or int(settings.get("top") or 5)
    minimum = args.min if args.min is not None else float(settings.get("min") or 0.6)
    targets = args.dirs or [str(run.root)]
    files, stats = collect(run, targets, settings.get("extensions") or [".dart"],
                           args.tests or settings.get("include_tests"), project_only=args.project_only)
    notes = [] if run.allowed else ["(mode local : %s)" % run.reason]
    cap = args.max_files if run.allowed else MAX_FIND_FILES
    if len(files) > cap:
        print("-- %d fichiers dépassent le plafond de %d : rien n'est envoyé ni présélectionné. "
              "Restreins le dossier ou passe --max-files %d (tous les fichiers sont criblés, puis les meilleurs vérifiés)." %
              (len(files), cap, len(files)))
        run.log(backend="none", files=len(files), capped=cap)
        return 2
    if not files:
        print("\n".join(notes + ["-- aucun fichier à cribler", footer(run, stats, 0)]))
        run.log(backend="none", files=0)
        return 1
    texts = {}
    for path in files:
        try:
            texts[path] = load_text(path)[0]
        except (OSError, ValueError):
            texts[path] = ""
    structures, approx_files, _ = structures_for(run, files, {str(p): t for p, t in texts.items()})
    if approx_files:
        notes.append("-- outline approx (repli regex) pour %d fichiers" % len(approx_files))
    candidates = files
    lines, backend = find_jev(run, args.description, candidates, structures, texts, top, minimum) if run.allowed else (None, "local")
    if lines is None and run.allowed:
        run.failed = True
        notes.append("(mode local : Jev en erreur — %s)" % ("; ".join(sorted(set(run.errors))) or "aucune réponse exploitable"))
    if lines is None:
        lines, backend = find_local(run, args.description, files, structures, texts, top), "local"
    print("\n".join(notes + lines + [footer(run, stats, len(files) if backend == "local" else run.record["screened_files"])]))
    run.log(backend=backend, files=len(files), errors=len(run.errors))
    return 0


def find_documents(run, files, structures, texts):
    return ["%s %s\n%s\n%s" % (run.rel(p), run.rel(p), skeleton(run.rel(p), structures.get(str(p)), texts[p]), texts[p]) for p in files]


def find_local(run, description, files, structures, texts, top):
    ranked = [(i, s) for i, s in bm25.rank(description, find_documents(run, files, structures, texts)) if s > 0][:top]
    if not ranked:
        return ["-- aucune correspondance lexicale parmi %d fichiers ; essaie grep ou une autre formulation" % len(files)]
    out = ["-- classement lexical BM25 (non sémantique) :"]
    for index, value in ranked:
        path = files[index]
        blocks = [b for b in blocks_for(path, texts[path], structures.get(str(path))) if not b["context"]]
        scores = local_scores(description, blocks)
        best = max(blocks, key=lambda b: scores[b["id"]], default=None)
        where = "%s:%d  %s" % (run.rel(path), best["line"], best["label"]) if best else run.rel(path)
        out.append("%5.1f  %s" % (value, where))
    return out


def find_question(field, reference="file"):
    return jev.noul(
        {"question": "Does the code in `%s.path` implement part of the behaviour described by `goal`?" % reference,
         "focus": "Use `%s.%s` to judge what this file implements. The names or language can differ from the goal. "
                  "A matching file need not implement the entire flow." % (reference, field)},
        "This file implements a step of the requested behaviour",
        "This file only mentions, calls or supports code implementing that behaviour")


def find_jev(run, description, files, structures, texts, top, minimum):
    goal = policy.redact(description)
    fids = {"f%d" % (i + 1): path for i, path in enumerate(files)}
    requests = [({"goal": goal, "file": {
        "path": run.rel(path), "skeleton": policy.redact(skeleton(run.rel(path), structures.get(str(path)), texts[path], SECRETS))}},
        {"match": find_question("skeleton")}, None, fid) for fid, path in fids.items()]
    batch = min(8, max(1, run.cfg["find"].get("batch_files", 8)))
    if batch > 1:
        items = [(fid, state["file"]) for state, _, _, fid in requests]
        requests = []
        for i in range(0, len(items), batch):
            requests.extend(pack({"goal": goal}, "files", items[i:i + batch],
                                 lambda fid: find_question("skeleton", "files." + fid), "screen"))
    probe = max(1, FIND_PROBE // batch)
    answers, errors = ask_all(run.client, requests[:probe])
    if any(noul_p(v) is not None for v in answers.values()) and requests[probe:]:
        more, more_errors = ask_all(run.client, requests[probe:])
        answers.update(more)
        errors += more_errors
    if batch > 1:
        answers = {(fid, "match"): value for (_, fid), value in answers.items()}
    run.record["batch_files"] = batch
    run.errors += errors
    screen = {fid: noul_p(answers.get((fid, "match"))) for fid in fids}
    run.record["screened_files"] = sum(v is not None for v in screen.values())
    if all(v is None for v in screen.values()):
        return None, "local"
    ranked = sorted((fid for fid in fids if screen[fid] is not None), key=lambda f: screen[f], reverse=True)
    verify = []
    for fid in ranked[:max(VERIFY_TOP, top)]:
        path = fids[fid]
        state = {"goal": goal, "file": {"path": run.rel(path), "content": policy.redact(texts[path])}}
        questions = {"match": find_question("content")}
        if jev.estimate_tokens(state) + jev.estimate_tokens(questions) > jev.STATE_TOKEN_BUDGET:
            continue
        verify.append((state, questions, None, fid))
    checked, verify_errors = ask_all(run.client, verify)
    run.errors += verify_errors
    results = []
    for fid in ranked:
        p = noul_p(checked.get((fid, "match")))
        results.append({"p": screen[fid] if p is None else p, "verified": p is not None,
                        "path": fids[fid], "fid": fid, "block": None})
    results.sort(key=lambda r: -r["p"])
    matches = [r for r in results if r["p"] >= minimum]
    kept = matches[:top]
    out = []
    if errors or verify_errors:
        out.append("-- erreurs Jev : %s" % "; ".join(sorted(set(errors + verify_errors))))
    missing = sum(1 for v in screen.values() if v is None)
    if missing:
        out.append("-- %d fichiers non criblés (erreur Jev) : absents du classement" % missing)
    if not kept:
        best = max((r["p"] for r in results), default=0)
        out.append("-- aucune correspondance sûre parmi %d fichiers criblés (meilleur p=%.2f) ; le criblage peut rater un fichier, "
                   "essaie grep ou une autre formulation" % (len(files) - missing, best))
        weak = results[:min(top, 3)]
        if weak:
            out.append("-- candidats faibles :")
            kept = weak
    locations, sent_of = [], {}
    for r in kept[:3]:
        path, fid = r["path"], r["fid"]
        blocks = [b for b in blocks_for(path, texts[path], structures.get(str(path))) if not b["context"]]
        if not blocks or len(blocks) > jev.MAX_OPTIONS:
            continue
        if len(blocks) == 1:
            r["block"] = blocks[0]
            continue
        state = {"goal": goal, "file": run.rel(path)}
        state["blocks"] = dict(block_items(blocks, state, "code", texts[path]))
        questions = {"where": jev.choice({"question": "Which block of `blocks` best locates the part of `goal` implemented in this file?"},
                                         {key: value["label"] for key, value in state["blocks"].items()})}
        if jev.estimate_tokens(state) + jev.estimate_tokens(questions) > jev.STATE_TOKEN_BUDGET:
            continue
        locations.append((state, questions, None, fid))
        sent_of[fid] = {b["id"]: b for b in blocks}
    located, locate_errors = ask_all(run.client, locations)
    run.errors += locate_errors
    if locate_errors:
        out.append("-- localisation incomplète : %s ; les fichiers restent dans le classement" % "; ".join(sorted(set(locate_errors))))
    for r in kept:
        if r["fid"] in sent_of:
            options = sent_of[r["fid"]]
            answer = located.get((r["fid"], "where"))
            picked = choice_of(answer, options)
            if (noul_p(answer) or 0) >= 0.5:
                r["block"] = options.get(picked)
    for r in kept:
        if r["verified"]:
            out.append("%.2f  %s" % (r["p"], where_text(run.rel(r["path"]), r["block"], True)))
        else:
            out.append("~%.2f %s  (score non vérifié : plan seul)" % (
                r["p"], where_text(run.rel(r["path"]), r["block"], True)))
    if len(matches) > len(kept):
        out.append("-- %d autres candidats au-dessus du seuil non affichés (--top %d)" % (len(matches) - len(kept), top))
    out.append("-- pistes, pas inventaire complet : pour un parcours, suis les appels et les modèles de données ; "
               "vérifie chaque partie de la demande avant de conclure.")
    return out, "jev"


def which_question():
    return jev.noul(
        {"question": "Based on `blocks`, is the answer to `question` yes for the file `file`?",
         "focus": "`blocks` may be only a section of the file; answer from what these blocks show."},
        "Yes, these blocks show the property", "No, these blocks do not show the property")


def file_size(path):
    try:
        return path.stat().st_size
    except OSError:
        return 0


def which_main(argv):
    parser = argparse.ArgumentParser(prog="lens which", description="Sonder une propriété oui/non fichier par fichier.")
    parser.add_argument("-q", action="store_true", help="n'afficher que les oui")
    parser.add_argument("--min", type=float)
    parser.add_argument("--max", type=int, help="plafond de fichiers sondés (défaut : lens.which_max_files, %d)" % WHICH_MAX_FILES)
    parser.add_argument("question")
    parser.add_argument("paths", nargs="+")
    args = parser.parse_args(argv)
    run = Run("which")
    if not run.allowed:
        print("lens which demande Jev (%s) : utilise grep, dart-outline ou lis les fichiers." % run.reason)
        run.log(backend="none")
        return 3
    minimum = args.min if args.min is not None else float(run.cfg["lens"]["threshold"])
    files, stats = collect(run, args.paths, run.cfg["find"].get("extensions") or [".dart"], True)
    if not files:
        print("-- aucun fichier à sonder\n" + footer(run, stats, 0, "sondés"))
        return 1
    cap = args.max or int(run.cfg["lens"].get("which_max_files") or WHICH_MAX_FILES)
    if len(files) > cap:
        size = sum(file_size(f) for f in files)
        print("-- %d fichiers à sonder, au-delà du plafond de %d (lens.which_max_files) : rien n'est envoyé. "
              "Coût estimé d'après la taille des fichiers : ~%dk tokens. Restreins le dossier ou passe --max %d." % (
                  len(files), cap, round(size / jev.CHARS_PER_TOKEN / 1000), len(files)))
        print(footer(run, stats, 0, "sondés"))
        run.log(backend="none", files=len(files), capped=cap)
        return 2
    texts, rows = {}, []
    for path in files:
        try:
            texts[path] = load_text(path)[0]
        except (OSError, ValueError) as error:
            rows.append({"path": path, "p": None, "reason": "illisible (%s)" % chunks.clip(str(error), 60)})
    structures, approx_files, _ = structures_for(run, list(texts), {str(p): t for p, t in texts.items()})
    question = policy.redact(args.question)
    requests, sections = [], {}
    for index, path in enumerate(files):
        if path not in texts:
            continue
        text = texts[path]
        blocks = [b for b in blocks_for(path, text, structures.get(str(path))) if not b["context"]] or \
            chunks.text_blocks(text, secrets=SECRETS)
        if not blocks:
            rows.append({"path": path, "p": None, "reason": "vide"})
            continue
        base = {"question": question, "file": run.rel(path)}
        items = block_items(blocks, base, "code", text)
        reserve = 300 + min(len(items), jev.MAX_OPTIONS) * 20
        parts = []
        for chunk in pack(base, "blocks", items, None, None, reserve=reserve):
            keys = list(chunk)
            parts += [{k: chunk[k] for k in keys[i:i + jev.MAX_OPTIONS]} for i in range(0, len(keys), jev.MAX_OPTIONS)]
        for number, chunk in enumerate(parts):
            questions = {"yes": which_question()}
            if len(chunk) >= 2:
                questions["where"] = jev.choice({"question": "Which block of `blocks` best shows the answer to `question`?"},
                                                {k: v["label"] for k, v in chunk.items()})
            requests.append((dict(base, blocks=chunk, section="%d/%d" % (number + 1, len(parts))), questions, None, (index, number)))
        sections[index] = (path, {b["id"]: b for b in blocks}, [list(chunk) for chunk in parts])
    answers, errors = ask_all(run.client, requests) if requests else ({}, [])
    for index, (path, by_id, parts) in sections.items():
        best, win, failed = None, None, 0
        for number in range(len(parts)):
            p = noul_p(answers.get(((index, number), "yes")))
            if p is None:
                failed += 1
                continue
            if best is None or p > best:
                best, win = p, number
        row = {"path": path, "p": best, "failed": failed, "sections": len(parts), "reason": "erreur Jev"}
        if best is not None and best >= minimum:
            row["block"], row["exact"] = locate(answers.get(((index, win), "where")), parts[win], by_id, args.question)
        rows.append(row)
    rows.sort(key=lambda r: (r["p"] is None, -(r["p"] or 0), str(r["path"])))
    out = []
    if approx_files:
        out.append("-- outline approx (repli regex) pour %d fichiers" % len(approx_files))
    if errors:
        out.append("-- erreurs Jev : %s" % "; ".join(sorted(set(errors))))
    yes = 0
    for row in rows:
        rel = run.rel(row["path"])
        partial = " (%d/%d sections non jugées)" % (row["failed"], row["sections"]) if row.get("failed") and row["p"] is not None else ""
        if row["p"] is None:
            if not args.q:
                out.append("   ?  %s  %s" % (row["reason"], rel))
            continue
        if row["p"] >= minimum:
            yes += 1
            out.append("%.2f  oui  %s%s" % (row["p"], where_text(rel, row["block"], row["exact"]), partial))
        elif not args.q:
            out.append("%.2f  non  %s%s" % (row["p"], rel, partial))
    unjudged = sum(1 for row in rows if row["p"] is None)
    out.append("-- %d oui (p ≥ %.2f) ; « non » = propriété non vue dans les passages envoyés, pas une preuve d'absence" % (yes, minimum))
    if unjudged:
        out.append("-- %d fichiers non jugés (erreur Jev, illisibles ou vides)%s" % (unjudged, " : relance sans -q pour la liste" if args.q else ""))
    out.append(footer(run, stats, len(files), "sondés"))
    judged = len(rows) - unjudged
    if not judged:
        out.insert(0, "(Jev en erreur : aucun fichier jugé ; utilise grep ou lis les fichiers)")
    print("\n".join(out))
    run.log(backend="jev", files=len(files), selected=yes, errors=len(errors), unjudged=unjudged)
    return 0 if judged else 1


def main(argv):
    if argv and argv[0] == "context":
        from jev_flutter import context
        return context.main(argv[1:])
    if argv and argv[0] == "find":
        return find_main(argv[1:])
    if argv and argv[0] == "which":
        return which_main(argv[1:])
    args = parse_focus(argv)
    if args.help:
        print(USAGE)
        return 0
    if not args.question or (args.command is None and not args.paths) or (args.command is not None and (args.paths or not args.command)):
        sys.stderr.write(USAGE + "\n")
        return 2
    return focus_command(args) if args.command is not None else focus_files(args)


if __name__ == "__main__":
    try:
        status = main(sys.argv[1:])
        sys.stdout.flush()
        sys.exit(status)
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(141)
